<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: starting the Agent must not flash a console window at the user.
         The layouts and status diagnostic flags reattach to the parent console instead. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AutoLang</AssemblyName>
    <RootNamespace>AutoLang.Agent</RootNamespace>
    <Version>0.1.0</Version>
    <ApplicationIcon>Resources/tray.ico</ApplicationIcon>

    <!-- Self-contained so users never have to install a .NET runtime.
         Trimmed because WinForms is gone: with it, the SDK refuses to trim at all (NETSDK1175)
         and the download was 155MB. Without it, 12.6MB. -->

    <!--
      Not a single file, and this was measured rather than chosen.

      Windows Defender quarantined the single-file build as Behavior:Win32/Persistence.A!ml -
      three publishes in a row, in two different output folders, deleted while dotnet was still
      writing them. `dist\agent\` came out empty and GenerateBundle failed with "Could not find
      file ...\AutoLang.exe". The same source published with PublishSingleFile=false survived both
      the publish and being run. So the trigger is the self-extracting bundle, not the code, not
      the path, and not the icon.

      That is a known shape to an antivirus: one unsigned executable that unpacks a runtime into a
      temp folder at startup looks like a dropper because droppers do exactly that. A folder of
      ordinary DLLs beside a 150KB host does not.

      The cost is real and small: 49 files and 19MB installed, instead of one file and 13MB. The
      installer copies a folder, which it had to create anyway. What it buys is a product that
      does not delete itself on a default Windows machine.

      This does not replace code signing. It removes the free part of the problem.
    -->
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!--
      IL2026 fires on every JsonSerializer call because the trimmer cannot statically prove the
      types survive. They do: Wire.Json and ConversationStore both set a TypeInfoResolver from a
      source-generated context, which is what makes serialisation work in a trimmed build at all.

      Suppressed rather than tolerated because ten warnings on every build train people to stop
      reading warnings, and the next one might matter. What the trimmer cannot prove,
      SerializationContextTests does - it exercises every wire and stored type through the same
      options the product uses, so a type added without its [JsonSerializable] line fails there.
    -->
    <NoWarn>$(NoWarn);IL2026</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded rather than copied, so a single-file publish stays a single file. -->
    <EmbeddedResource Include="Resources/tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Every wire DTO and stored record lives in AutoLang.Core and is serialised by reflection, which
      the trimmer cannot see through (IL2026). Rooting the whole assembly keeps them, and it is
      cheap: Core is about 80KB against a 12MB executable. The alternative, source-generated
      serialisation contexts, would buy startup time this product does not need and add a second
      place for every message type to be declared.

      The smoke test is what actually proves this works - a trimmed build that serialises correctly
      cannot be established by reading the csproj.
    -->
    <TrimmerRootAssembly Include="AutoLang.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoLang.Core\AutoLang.Core.csproj" />
  </ItemGroup>

</Project>
